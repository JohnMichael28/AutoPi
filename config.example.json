    "tiers": [
      {
        "name": "pi",
        "base_url": "http://127.0.0.1:8080",
        "model": "qwen3-0.6b",
        "timeout_s": 45
      }
    ],
    "retry_after_s": 5,
    "profiles": {
      "driving": {
        "allow": [
          "read"
        ]
      },
      "service": {
        "allow": [
          "read",
          "actuate"
        ]
      }
    },
    "max_turns": 5,
    "max_tool_calls": 3,
    "deadline_s": 75,
    "max_answer_chars": 600,
    "judge": {
      "llm_enabled": false,
      "llm_tiers": [
        "pi"
      ]
    },
    "route_first": true
  },
  "warmup": {
    "running_rpm": 400,
    "settled_rpm": 1000,
