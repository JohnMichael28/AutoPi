    "reports_dir": "reports",
    "keep_reports": 20,
    "text_logs": [
      "logs/boot.log",
      "logs/security.jsonl"
    ],
    "max_text_log_kb": 512,
    "min_free_mb": 500,
    "log_flush_s": 60,
    "log_flush_rows": 50,
    "protect": [
      "config.json",
      "models",
      "data/modules.json",
      "reports/latest.html"
    ]
  },
  "install": {
    "llama_dir": "~/llama.cpp",
