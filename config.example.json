  "report": {
    "port": 8088,
    "share_minutes": 15,
    "car_name": "2023 Subaru Outback Wilderness (FA24 turbo, CVT)",
    "default_share": "hotspot",
    "hotspot_iface": "wlan0",
    "hotspot_prefix": "AutoPi"
  },
  "modules": {
    "cache": "data/modules.json",
    "sweep_from": "700",
    "sweep_to": "7F7"
